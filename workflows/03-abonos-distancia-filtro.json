    {
      "name": "Normalizar entrada de correo",
      "id": "8d9f77ee-a6a7-53f0-b454-fd35f417feaa",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        100
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// #32: adaptar entradas; no filtrar pagos ni decidir abonos.\nconst input = $json;\nconst isForm = Object.prototype.hasOwnProperty.call(input, 'asunto') || Object.prototype.hasOwnProperty.call(input, 'cuerpo');\nconst text = value => typeof value === 'string' ? value.replace(/\\r\\n?/g, '\\n') : '';\nconst asunto = text(isForm ? input.asunto : input.subject);\nconst cuerpo = text(isForm ? input.cuerpo : (input.textPlain || input.text));\nconst referencia = text(isForm ? input.referencia : (input.messageId || input.metadata?.['message-id'])).trim();\nlet motivo = '';\nif (!asunto.trim() || !cuerpo.trim()) motivo = 'Falta asunto o cuerpo de texto plano; revisar la entrada';\nelse if (!referencia) motivo = 'Falta referencia de prueba o Message-ID del correo';\nelse if (cuerpo.length > 20000 || asunto.length > 998 || referencia.length > 300) motivo = 'Entrada demasiado larga; revisar sin procesar automáticamente';\nreturn {json: {origen: isForm ? 'formulario' : 'imap', referencia, asunto, cuerpo, entrada_valida: !motivo, motivo}};\n"
      }
    },
    {
      "name": "Configurar y probar la entrada",
      "id": "3cac9bdf-8650-5416-8204-7ac243bc98ea",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -450
      ],
      "parameters": {
        "content": "## HU-03 · Filtro (#33)\nExportación parcial e inactiva.\nFormulario: Test URL, referencia/asunto/cuerpo. IMAP deshabilitado hasta seleccionar credencial de pruebas.\nEl Switch separa extraer, ignorar y revisar. Las salidas terminan en nodos sin acciones: #34 añadirá IA y #38 el aviso de revisión.\nVer docs/hu03-filtro.md. No publicar sin revisión.",
        "height": 370,
        "width": 540
      }
    },
    {
      "name": "Filtrar aviso bancario",
      "id": "5edcb3c7-9abd-58ae-ab90-0e28379cba70",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        100
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// #33: clasificar el aviso; la extracción de campos corresponde a #34.\nif ($json.entrada_valida !== true) {\n  return {json:{...$json,es_pago:false,ruta:'revisar',motivo:$json.motivo || 'Entrada inválida; revisar antes de continuar'}};\n}\nconst texto = ($json.asunto + '\\n' + $json.cuerpo).normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').toLowerCase();\nconst es_pago = /\\b(?:has recibido un bizum|transferencia recibida|se ha abonado una transferencia)\\b/.test(texto);\nreturn {json:{...$json,es_pago,ruta:es_pago ? 'extraer' : 'ignorar',motivo:es_pago ? '' : 'No es un aviso de pago recibido reconocido'}};\n"
      }
    },
