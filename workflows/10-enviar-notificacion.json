    {
      "parameters": {
        "jsCode": "// Code «Preparar respuesta» (10 · Enviar notificación) · Run Once for All Items\n// Recibe la salida de «Enviar correo en HTML» o «Enviar correo de texto» y devuelve\n// un item { enviado, para, asunto, messageId } al flujo que llama.\n\nconst { para, asunto } = $('Comprobar la notificación').first().json;\nconst envio = $input.first().json;\n\nreturn [{ json: { enviado: true, para, asunto, messageId: envio.messageId ?? null } }];\n"
