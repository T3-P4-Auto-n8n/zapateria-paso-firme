    {
      "parameters": {
        "jsCode": "// Code «Comprobar la notificación» (10 · Enviar notificación) · Run Once for All Items\n// Recibe { para, asunto, texto, html } de «Al enviar una notificación» y devuelve\n// el mismo item limpio o para con error sin enviar nada.\n\nconst entrada = $input.first().json;\n\n// Un campo vacío puede llegar como null, \"\" o no llegar\nconst limpio = v => (v == null ? '' : String(v).trim());\nconst para = limpio(entrada.para);\nconst asunto = limpio(entrada.asunto);\nconst texto = limpio(entrada.texto);\nconst html = limpio(entrada.html);\n\nif (!para || !para.includes('@')) throw new Error('Enviar notificación: falta `para`');\nif (!asunto) throw new Error('Enviar notificación: falta `asunto`');\nif (!texto && !html) throw new Error('Enviar notificación: falta el cuerpo del correo');\n\nreturn [{ json: { para, asunto, texto, html } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
